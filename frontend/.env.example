# Frontend environment — copy to .env (Vite). Never commit secrets here.
# Local dev proxies /api to the Worker (see vite.config.ts), so this can stay empty.
# VITE_API_URL=http://localhost:8787/api
# Production (Cloudflare Pages): set VITE_API_URL to your Worker URL, e.g.
# VITE_API_URL=https://al-saifee-api.<account>.workers.dev/api
