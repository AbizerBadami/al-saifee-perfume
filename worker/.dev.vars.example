# Copy to .dev.vars for local worker dev:  cp .dev.vars.example .dev.vars
# NEVER commit .dev.vars. NEVER reuse the example secret in production.
# Generate a real secret:  openssl rand -base64 48
# Production: wrangler secret put JWT_SECRET / RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET

